<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Orleans -->
    <PackageVersion Include="Microsoft.Orleans.Core.Abstractions" Version="10.4.2" />
    <PackageVersion Include="Microsoft.Orleans.Client" Version="10.3.1" />
    <PackageVersion Include="Microsoft.Orleans.Server" Version="10.4.2" />
    <PackageVersion Include="Microsoft.Orleans.Reminders" Version="10.4.2" />
    <PackageVersion Include="Microsoft.Orleans.Sdk" Version="10.4.2" />
    <PackageVersion Include="Microsoft.Orleans.Serialization" Version="10.4.2" />
    <PackageVersion Include="Microsoft.Orleans.Serialization.Abstractions" Version="10.3.1" />
    <PackageVersion Include="Microsoft.Orleans.Serialization.SystemTextJson" Version="10.4.2" />
    <PackageVersion Include="Microsoft.Orleans.TestingHost" Version="10.4.2" />
    <PackageVersion Include="Microsoft.Orleans.Analyzers" Version="10.3.1" />
    <PackageVersion Include="OrleansTestKit10" Version="10.0.0" />
    <!--
      Orleans.Providers.MongoDB has no Orleans 10 release - 9.5.0 is a 9.x binary running on the 10.x
      runtime. Only cluster membership and grain storage are safe to use from it; the 9.x reminder table
      hangs the 10.x reminder service. See the hosting documentation in Source/Choreography/Hosting.
    -->
    <PackageVersion Include="Orleans.Providers.MongoDB" Version="9.5.0" />
    <PackageVersion Include="MongoDB.Driver" Version="3.14.1" />
    <PackageVersion Include="SharpCompress" Version="0.50.11" />
    <PackageVersion Include="Snappier" Version="1.3.3" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <!-- EF Core (SQL storage) -->
    <PackageVersion Include="Cratis.Arc.Core" Version="24.2.1" />
    <PackageVersion Include="Cratis.Arc.EntityFrameworkCore" Version="24.2.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0" />
    <!-- Microsoft.Data.SqlClient (via EF Core SqlServer) pulls System.Security.Cryptography.Pkcs 9.0.11, which
         GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7 affect. Transitive pinning is off here, so Choreography.Storage.Sql
         references it directly; drop this when SqlClient's own floor is 10.0.13 or later. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
    <!-- Cratis -->
    <PackageVersion Include="Cratis.Arc.MongoDB" Version="24.2.1" />
    <PackageVersion Include="Cratis.Chronicle" Version="19.187.0" />
    <PackageVersion Include="Cratis.Chronicle.XUnit.Integration" Version="19.187.0" />
    <PackageVersion Include="Cratis.Fundamentals" Version="7.34.4" />
    <PackageVersion Include="Cratis.Metrics.Roslyn" Version="7.34.4" />
    <PackageVersion Include="Cratis.Specifications.XUnit.v3" Version="5.3.0" />
    <!-- Serialization & primitives -->
    <PackageVersion Include="OneOf" Version="3.0.271" />
    <PackageVersion Include="OneOf.SourceGenerator" Version="3.0.271" />
    <PackageVersion Include="System.Reactive" Version="7.0.0" />
    <!-- Analyzers (referenced PrivateAssets="All" from Directory.Build.props) -->
    <PackageVersion Include="StyleCop.Analyzers" Version="1.3.180" NoWarn="NU5104" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.342" />
    <!-- Specs -->
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net11.0'">
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="System.Text.Json" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageVersion Include="System.Text.Json" Version="11.0.0" />
  </ItemGroup>
</Project>