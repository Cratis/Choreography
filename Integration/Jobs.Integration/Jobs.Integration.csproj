<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Choreography.Jobs.Integration</AssemblyName>
        <RootNamespace>Cratis.Choreography.Jobs.Integration</RootNamespace>
        <IsTestProject>true</IsTestProject>
        <IsPackable>false</IsPackable>
        <!-- xUnit v3 test projects are executables -->
        <OutputType>Exe</OutputType>
        <!-- Test projects always target net10.0 only. The plural form overrides the packaging build's multi-targeting
             and is needed for the VSTest adapter to land beside the test assembly. -->
        <TargetFrameworks>net10.0</TargetFrameworks>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="coverlet.collector" />

        <PackageReference Include="Cratis.Specifications.XUnit.v3" />
        <PackageReference Include="NSubstitute" />
        <PackageReference Include="xunit.v3.mtp-off" />
        <PackageReference Include="xunit.runner.visualstudio" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="Microsoft.Orleans.TestingHost" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../../Source/Choreography/Choreography.csproj" />
        <ProjectReference Include="../../Source/Choreography.Storage/Choreography.Storage.csproj" />
        <ProjectReference Include="../../Source/Choreography.Storage.MongoDB/Choreography.Storage.MongoDB.csproj" />
        <ProjectReference Include="../../Source/Choreography.Storage.Sql/Choreography.Storage.Sql.csproj" />
    </ItemGroup>
</Project>
