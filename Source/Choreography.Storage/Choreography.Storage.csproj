<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Choreography.Storage</AssemblyName>
        <RootNamespace>Cratis.Choreography.Storage</RootNamespace>
        <Description>Storage API for the Cratis.Choreography job system - job and job step storage abstractions and state</Description>
        <PackageTags>orleans;jobs;storage;cratis</PackageTags>
        <RepositoryUrl>https://github.com/Cratis/Choreography</RepositoryUrl>
        <ProjectUrl>https://github.com/Cratis/Choreography</ProjectUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Orleans.Core.Abstractions" />
        <PackageReference Include="Cratis.Fundamentals" />
        <PackageReference Include="OneOf" />
        <PackageReference Include="System.Reactive" />
    </ItemGroup>
</Project>
