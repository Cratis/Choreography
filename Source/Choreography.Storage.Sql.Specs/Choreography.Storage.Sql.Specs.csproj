<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Choreography.Storage.Sql.Specs</AssemblyName>
        <RootNamespace>Cratis.Choreography</RootNamespace>
        <IsTestProject>true</IsTestProject>
        <IsPackable>false</IsPackable>
        <!-- xUnit v3 test projects are executables -->
        <OutputType>Exe</OutputType>
        <!-- Test projects always target net11.0 only, also in the packaging build. -->
        <TargetFrameworks>net11.0</TargetFrameworks>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Choreography/Choreography.csproj" />
        <ProjectReference Include="../Choreography.Storage/Choreography.Storage.csproj" />
        <ProjectReference Include="../Choreography.Storage.Sql/Choreography.Storage.Sql.csproj" />
    </ItemGroup>
</Project>
