<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Choreography.Storage.Sql</AssemblyName>
        <RootNamespace>Cratis.Choreography.Storage.Sql</RootNamespace>
        <Description>SQL storage provider (EF Core: SQL Server, PostgreSQL, SQLite) for the Cratis.Choreography job system</Description>
        <PackageTags>orleans;jobs;storage;sql;efcore;cratis</PackageTags>
        <RepositoryUrl>https://github.com/Cratis/Choreography</RepositoryUrl>
        <ProjectUrl>https://github.com/Cratis/Choreography</ProjectUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <!-- EF Core 10 ships net10.0 only, so the SQL provider does too; the other packages keep the
             repository-wide net10.0/net11.0 packaging matrix. -->
        <TargetFrameworks Condition="'$(IsPackaging)' == 'true'">net10.0</TargetFrameworks>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Cratis.Arc.EntityFrameworkCore" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
        <PackageReference Include="System.Security.Cryptography.Pkcs" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Cratis.Choreography.Storage.Sql.Specs" />
        <InternalsVisibleTo Include="Cratis.Choreography.Jobs.Integration" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../Choreography/Choreography.csproj" />
        <ProjectReference Include="../Choreography.Storage/Choreography.Storage.csproj" />
    </ItemGroup>
</Project>
